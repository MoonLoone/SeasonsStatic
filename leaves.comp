#version 310 es
precision highp float;
layout(local_size_x = 64) in;
struct Leaf { vec2 position; vec2 velocity; float rotation; float angularVel; float size; float rnd; float flip; float sway; };
layout(std430, binding = 0) buffer Buf { Leaf items[]; };
uniform vec2 uResolution; uniform float uTime; uniform float uDt; uniform uint uCount;

#include "common_noise.glsl"

void main(){
    uint id = gl_GlobalInvocationID.x;
    if (id >= uCount) return;
    Leaf L = items[id];
    float t = uTime; float W = uResolution.x, H = uResolution.y;

    float g1 = vnoise(vec2(t * 0.30, 3.1));
    float g2 = vnoise(vec2(t * 0.80, 9.4));
    float env = 0.40 + 2.20 * (0.6 * g1 + 0.4 * g2);
    float wAng = (vnoise(vec2(t * 0.15, 8.7)) - 0.5) * 1.4;
    vec2 windDir = normalize(vec2(cos(wAng), -0.12 - 0.15 * sin(wAng)));
    vec2 gust = windDir * 45.0 * env;

    float fall = 55.0 + L.rnd * 45.0;
    L.sway += uDt * (1.4 + L.rnd * 1.6);
    float swayV = sin(L.sway) * (55.0 + L.rnd * 45.0);

    vec2 q = L.position / 260.0;
    vec2 swirl = curl(q + t * 0.06) * 24.0 * (0.5 + env * 0.4);

    vec2 target = vec2(gust.x + swayV + swirl.x, fall + gust.y * 0.3 + swirl.y);
    L.velocity += (target - L.velocity) * min(1.5 * uDt, 1.0);
    L.position += L.velocity * uDt;

    L.angularVel = L.angularVel * 0.985 + curl(q * 1.6 + 5.0).x * uDt * 1.2;
    float baseSpin = (L.rnd - 0.5) * 2.4;
    L.rotation += (baseSpin + L.angularVel + cos(L.sway) * 0.8) * uDt;
    L.flip += uDt * (1.0 + L.rnd * 1.6);

    float m = L.size + 30.0;
    if (L.position.x < -m)     L.position.x += W + 2.0 * m;
    if (L.position.x > W + m)  L.position.x -= W + 2.0 * m;
    if (L.position.y < -m)     L.position.y += H + 2.0 * m;
    if (L.position.y > H + m)  L.position.y -= H + 2.0 * m;

    items[id] = L;
}
