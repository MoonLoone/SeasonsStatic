#version 310 es
precision highp float;
layout(local_size_x = 64) in;
struct Bubble { vec2 position; vec2 velocity; float radius; float rnd; float phase; float wobble; float life; float spin; };
layout(std430, binding = 0) buffer Buf { Bubble items[]; };
uniform vec2 uResolution; uniform float uTime; uniform float uDt; uniform uint uCount;

#include "common_noise.glsl"

void main(){
    uint id = gl_GlobalInvocationID.x;
    if (id >= uCount) return;
    Bubble b = items[id];
    float t = uTime; float W = uResolution.x, H = uResolution.y;

    float wAng = (vnoise(vec2(t * 0.08, 8.7)) - 0.5) * 0.6;
    vec2 windDir = normalize(vec2(0.38 + sin(wAng) * 0.22, -1.0));
    vec2 wind = windDir * 140.0;

    vec2 q = b.position / 220.0;
    vec2 swirl = curl(q + t * 0.05) * 26.0;

    float fa = (b.rnd - 0.5) * 0.55;
    float fca = cos(fa), fsa = sin(fa);
    vec2 wd = vec2(wind.x * fca - wind.y * fsa, wind.x * fsa + wind.y * fca);

    float catchW = 0.75 + b.rnd * 0.50;
    vec2 target = (wd + swirl) * catchW;
    b.velocity += (target - b.velocity) * min(1.9 * uDt, 1.0);

    b.wobble += uDt * (2.2 + b.rnd * 2.0);
    b.phase  += uDt * (0.35 + b.rnd * 0.50);
    b.spin   += uDt * (0.12 + b.rnd * 0.28);

    b.velocity.x += sin(b.wobble * 0.9) * 10.0 * uDt;
    b.position += b.velocity * uDt;

    float lifeRate = 0.015 + fract(b.rnd * 5.13) * 0.075;
    b.life += uDt * lifeRate;
    if (b.life > 0.88) b.life += uDt * 0.45;

    float mw = b.radius + 30.0;
    if (b.position.x < -mw)     b.position.x += W + 2.0 * mw;
    if (b.position.x > W + mw)  b.position.x -= W + 2.0 * mw;
    if (b.position.y < -mw)     b.position.y += H + 2.0 * mw;
    if (b.position.y > H + mw)  b.position.y -= H + 2.0 * mw;

    if (b.life > 1.0) {
        float fid = float(id);
        float h1 = hash(vec2(fid, t));
        float h2 = hash(vec2(t, fid * 1.7));
        float h3 = hash(vec2(fid * 0.3, t * 1.3));
        float h4 = hash(vec2(fid * 2.1, t * 0.7));
        float spd = 150.0 + h3 * 90.0;
        if (h4 < 0.40) {
            b.position = vec2(-mw, H * (0.08 + 0.84 * h1));
            b.velocity = vec2(spd, -spd * (0.2 + 0.5 * h2));
        } else if (h4 < 0.75) {
            b.position = vec2(W * h1, H + mw);
            b.velocity = vec2((h2 - 0.3) * 120.0, -spd);
        } else {
            b.position = vec2(W + mw, H * (0.08 + 0.84 * h1));
            b.velocity = vec2(-spd * 1.6, -spd * (0.2 + 0.5 * h2));
        }
        float hs = fract(h3 * 7.77);
        b.radius = (hs < 0.38) ? (18.0 + h3 * 20.0) : (42.0 + h3 * 53.0);
        b.rnd = h2; b.phase = h1 * 6.2831853; b.spin = h3 * 6.2831853; b.wobble = h2 * 6.2831853; b.life = 0.0;
    }

    items[id] = b;
}
